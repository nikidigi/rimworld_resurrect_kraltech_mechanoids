<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <RecipeDef ParentName="BaseHostileMechanoidRecipe">
        <defName>REM_KraltechMediumAlphaMech</defName>
        <label>resurrect hostile medium mechanoid (Alpha)</label>
        <description>Resurrect a hostile medium mechanoid. Its core must be reinitialized to accept new directives. Requires high subcores for reprogramming.</description>
        <ingredients>
          <li>
            <filter>
              <categories>
                <li>Corpses</li>
              </categories>
            </filter>
            <count>1</count>
          </li>
          <li>
            <filter>
              <thingDefs>
                <li>Steel</li>
              </thingDefs>
            </filter>
            <count>60</count>
          </li>
          <li>
            <filter>
              <thingDefs>
                <li>SubcoreHigh</li>
              </thingDefs>
            </filter>
            <count>2</count>
          </li>
        </ingredients>
        <fixedIngredientFilter>
          <thingDefs>
            <li>Corpse_Mech_AlphaLancer</li>
            <li>Corpse_Mech_AlphaPikeman</li>
            <li>Corpse_Mech_AlphaScyther</li>
            <li>Corpse_Mech_AlphaTesseron</li>
          </thingDefs>
        </fixedIngredientFilter>
        <researchPrerequisite>AlphaMechTech</researchPrerequisite>
      </RecipeDef>
    </value>
  </Operation>

